ub.com/repos/atuinsh/atuin/labels/type:feature", "name": "type:feature", "color": "a2eeef", "default": false, "description": "New feature or request", "archived_at": null, "archived_by": null}], "state": "closed", "locked": false, "assignees": [], "milestone": null, "comments": 2, "created_at": "2026-07-09T13:40:32Z", "updated_at": "2026-07-10T22:15:34Z", "closed_at": "2026-07-10T22:15:34Z", "assignee": null, "author_association": "NONE", "issue_field_values": [], "type": null, "active_lock_reason": null, "sub_issues_summary": {"total": 0, "completed": 0, "percent_completed": 0}, "issue_dependencies_summary": {"blocked_by": 0, "total_blocked_by": 0, "blocking": 0, "total_blocking": 0}, "body": "I really would like to be able to show the start and end of a command when the terminal width is not enough to show the full command.\n\n<img width=\"1101\" height=\"85\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/8efc652a-50aa-4806-a7da-2af6ba81c601\" />\n\nHow hstr is handling this:\n\n<img width=\"1118\" height=\"91\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/27fc111a-4cc9-45bd-8cad-bae7fe9e3a16\" />\n\n\nNo matter how small the terminal width is it is always showing the start and end of the command:\n\n<img width=\"552\" height=\"67\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/672a6740-7e80-4340-9f6d-822d3c50cf32\" />\n\n<img width=\"278\" height=\"61\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/5770753b-8d16-4a55-b06b-5100b56c98c3\" />\n\n\nI know that this can partially be achieved by adjusting the `max_preview_height`, but this only shows 1 command at a time, however the other implementation is really useful since I see multiple commands at a glance:\n\n<img width=\"282\" height=\"368\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/5bb77548-bda6-488d-b1aa-efdf4819a9c3\" />", "reactions": {"url": "https://api.github.com/repos/atuinsh/atuin/issues/3596/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "timeline_url": "https://api.github.com/repos/atuinsh/atuin/issues/3596/timeline", "performed_via_github_app": null, "state_reason": "completed", "pinned_comment": null, "score": 1.0}], "search_type": "lexical"}}