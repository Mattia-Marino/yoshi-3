_at": "2025-11-25T14:59:10Z", "updated_at": "2025-11-25T14:59:16Z", "closed_at": null, "assignee": null, "author_association": "NONE", "issue_field_values": [], "type": null, "active_lock_reason": null, "draft": false, "pull_request": {"url": "https://api.github.com/repos/excalidraw/excalidraw/pulls/10402", "html_url": "https://github.com/excalidraw/excalidraw/pull/10402", "diff_url": "https://github.com/excalidraw/excalidraw/pull/10402.diff", "patch_url": "https://github.com/excalidraw/excalidraw/pull/10402.patch", "merged_at": null}, "body": "This pull request addresses an issue where the \"Wrap text in container\" command would fail for text elements whose container has been deleted. These \"orphan\" text elements were not correctly identified by the action's predicate, preventing them from being wrapped.\r\n\r\nThe predicate for actionWrapTextInContainer has been updated to correctly identify text elements that are either not in a container or whose container is no longer present in the scene. This ensures that users can recover and re-wrap text elements that have lost their containers, improving the robustness of the text editing experience.\r\n\r\n\r\n\r\n\r\n", "reactions": {"url": "https://api.github.com/repos/excalidraw/excalidraw/issues/10402/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "timeline_url": "https://api.github.com/repos/excalidraw/excalidraw/issues/10402/timeline", "performed_via_github_app": null, "state_reason": null, "score": 1.0}], "search_type": "lexical"}}